{
  "name": "tarteel-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json && vite build && node scripts/version-help-assets.mjs",
    "build:server": "npx esbuild server/index.ts --bundle --platform=node --format=esm --outfile=dist-server/index.mjs --packages=external",
    "start": "node dist-server/index.mjs",
    "preview": "vite preview",
    "help:dashboard": "node scripts/help-dashboard.mjs",
    "test": "vitest run",
    "assets:v1": "node scripts/prepare-v1-assets.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.2.8",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@hono/node-server": "^1.19.9",
    "@tilawa/core": "file:../../packages/core",
    "hono": "^4.12.3",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "esbuild": "^0.27.3",
    "fake-indexeddb": "^6.2.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.7"
  }
}
